# Copy to .env and fill in. See docs/setup.md for how to obtain each value.

# --- TradingAgents / LLM backend ---
TRADINGAGENTS_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# gemma4-e2b-96k is a custom Modelfile build of gemma4:e2b with 96k context.
# Stock gemma4:e2b at the default context fails (see CLAUDE.md).
TRADINGAGENTS_DEEP_THINK_LLM=gemma4-e2b-96k
TRADINGAGENTS_QUICK_THINK_LLM=gemma4-e2b-96k
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# --- TradingAgents state (keep on the data volume, not the container home) ---
# The memory log holds past decisions plus the reflection written once each
# outcome is known; it is fed back into the portfolio manager's prompt. Left at
# its default (~/.tradingagents) it is deleted on every container rebuild.
TRADINGAGENTS_MEMORY_LOG_PATH=data/tradingagents/memory/trading_memory.md
TRADINGAGENTS_RESULTS_DIR=data/tradingagents/logs
TRADINGAGENTS_CACHE_DIR=data/tradingagents/cache

# --- Discord bot (optional — the app runs as a pure web dashboard if unset) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Webull SDK (optional — real-time quotes fall back to yfinance if unset) ---
WEBULL_SANDBOX=1
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# --- Reddit OAuth2 (leave blank) ---
# Reddit's Responsible Builder Policy ended self-serve API app creation, so
# these are not obtainable for a personal tool. Unset is the supported path:
# the sentiment analyst reads the public RSS search feed instead. See
# docs/setup.md.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
