# Copy to .env and fill in. See docs/setup.md for how to obtain each value.

# --- TradingAgents / LLM backend ---
TRADINGAGENTS_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
TRADINGAGENTS_DEEP_THINK_LLM=qwen3:latest
TRADINGAGENTS_QUICK_THINK_LLM=qwen3:latest
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# --- Discord bot (optional — the app runs as a pure web dashboard if unset) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- Webull SDK (optional — real-time quotes fall back to yfinance if unset) ---
WEBULL_SANDBOX=1
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# --- Reddit OAuth2 (optional — sentiment analyst falls back to RSS if unset) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
