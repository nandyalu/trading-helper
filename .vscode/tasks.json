{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build trading-bot Docker image",
            "type": "shell",
            // Same tag the dockge compose file deploys (image: trading-bot:local)
            "command": "docker build -t trading-bot:local .",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
